# The public URL of your deployed site.
# Used for constructing Stripe success/cancel URLs.
# Example: https://my-reading-site.onrender.com
SITE_URL=

# The URL to your Kick channel for the "Watch Live" button.
# Example: https://kick.com/your-channel
KICK_CHANNEL_URL=

# Your secret key from the Stripe dashboard.
# Example: sk_test_...
STRIPE_SECRET_KEY=

# The webhook signing secret from your Stripe webhook endpoint configuration.
# Example: whsec_...
STRIPE_WEBHOOK_SECRET=

# The ID of the Price object in Stripe for the 3-card reading product.
# Example: price_...
STRIPE_PRICE_3CARD=

# The incoming webhook URL from your n8n workflow.
# Example: https://your-n8n-instance.com/webhook/tarot
N8N_WEBHOOK_URL=

# A strong, secret key used to sign the webhook payload sent to n8n.
# Generate a secure random string for this.
N8N_AUTH_SECRET=
